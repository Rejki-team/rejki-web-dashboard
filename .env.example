# Konfigurasi Rejki Web Dashboard (Zero Hardcoded — semua via env).
# Salin ke `.env.local` dan sesuaikan.

# Base path API yang dipanggil klien. Saat dev, Vite proxy meneruskan `/api` → backend.
VITE_API_BASE_URL=/api/v1

# Target backend untuk Vite dev proxy (lihat vite.config.ts).
VITE_API_TARGET=http://localhost:8080

# Batas ukuran unggah bukti (byte) — selaras backend (5 MiB).
VITE_MAX_EVIDENCE_BYTES=5242880
